# Public Supabase project settings.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only key used by the ingestion command. Never expose this in the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional storage bucket created by the migration.
SUPABASE_MEDIA_BUCKET=challenge-media

# Application origin used for authentication redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
