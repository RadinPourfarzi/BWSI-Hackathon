# Use "mock" to run without Supabase; use "supabase" for shared/production data.
APP_DATA_PROVIDER=mock

# Enables x-user-id only with APP_DATA_PROVIDER=mock. Never use in production.
ALLOW_DEV_AUTH_HEADER=true

# Required when APP_DATA_PROVIDER=supabase.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
